# Godot 编辑器缓存（可重新生成）
.godot/
_玩家数据/
_更新缓存/

# 渲染与截图中间产物（本地留档，不进库）
_shot/
_预览/

# 本地工具与导出模板包（ffmpeg / cloudflared / export_templates.tpz）
_tools/

# 临时文件
*.bak
_test_save.json

# 凭据、本地设置及导出产物
.env
.env.*
!.env.example
export_credentials.cfg
*.keystore
*.p12
*.pfx
build/
builds/
exports/

# DCC / Python生成缓存
__pycache__/
*.pyc
*.blend1

# 本地开发者巡查位置、截图及隔离数据
_开发者数据/

# 本机验收、截图、测试与临时输出（正式报告放docs/verification）
/_验收/
/_测试数据/
/_截图/
/_临时/
/_record/
/dist/

# 编辑器/DCC备份；角色和可编辑源文件本身仍由显式清单审查
.vs/
.idea/
*.blend[0-9]*
*.tmp
*.dmp
