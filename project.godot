; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="岚桥站 0017"
config/description="最后一班地铁 · 夜班调度席 · 27 分钟"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/inference_on_variant=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.011, 0.014, 0.022, 1)
; 网页版走 Compatibility(GLES3)，默认一帧只渲染 32 盏灯。本作场景里有 106 盏，
; 超出部分会被静默丢弃，表现为“走到某些角度整片区域没灯”。128 覆盖全部灯，
; 单对象仍是最多 8 盏（默认值），片元开销不变。
limits/opengl/max_renderable_lights=128
